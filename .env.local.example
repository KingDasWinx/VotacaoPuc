# Supabase (servidor — nunca exponha ao cliente)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Upstash (rate limiting) — OPCIONAL.
# Sem essas vars o app roda normal, mas sem rate limit (recomendado em produção
# para proteger o login admin contra brute-force). Deixe em branco para desligar.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
